# URL of the 1C backend the API routes proxy to.
# If omitted, the app falls back to http://dev.1c.ikorniysrv.ru:85/eshop/hs/PAPI/v1
ONE_C_API_URL=http://dev.1c.ikorniysrv.ru:85/eshop/hs/PAPI/v1

# Domain used for nginx / certbot (replace example.com in nginx/conf.d/*.conf too)
DOMAIN=example.com
EMAIL=admin@example.com

# RMS integration. Set interactively via `make rms` (see Makefile).
# RMS is reached only by Next.js Route Handlers, never directly by the browser.
# rms and this app are separate docker-compose projects on separate networks,
# so `localhost`/`127.0.0.1` here means "this container", not RMS. Both apps
# join the external `rms-ecom-shared` network (see docker-compose.yml), where
# RMS is reachable by its container name.
RMS_API_URL=http://rms-app:8082
# Exact public browser origin, no trailing slash. Must be included in RMS app_origins / RMS_APP_ORIGINS.
# For npm run dev use http://localhost:3000; production requires HTTPS.
APP_ORIGIN=https://example.com
# Same persistent signing key as RMS; >=32 bytes. Never use NEXT_PUBLIC_ prefix.
RMS_SIGNING_KEY=

# Autodeploy cron interval, in minutes. Set interactively via `make autodeploy`.
# <60 -> every N minutes; multiple of 60 -> every N/60 hours.
AUTODEPLOY_INTERVAL_MIN=60
