# URL of the 1C backend the API routes proxy to.
# If omitted, the app falls back to http://dev.1c.ikorniysrv.ru:85/eshop/hs/PAPI/v1
ONE_C_API_URL=http://dev.1c.ikorniysrv.ru:85/eshop/hs/PAPI/v1

# Domain used for nginx / certbot (replace example.com in nginx/conf.d/*.conf too)
DOMAIN=example.com
EMAIL=admin@example.com

