# Без .dockerignore Docker пакует в build-контекст ВЕСЬ каталог проекта,
# включая certbot/conf — там Let's Encrypt хранит закрытые ключи аккаунта с
# правами root/0700, и сборка падает с "permission denied" у пользователя,
# от которого запущен `docker compose build` (см. certbot/conf/accounts).

# runtime-данные nginx/certbot — не нужны образу приложения, из них же
# и растёт permission denied
certbot
nginx

.git
.gitignore

node_modules
.next
out
coverage

npm-debug.log*
yarn-debug.log*
yarn-error.log*

.env
.env*.local
.env.example

.vercel
*.tsbuildinfo

deploy.log

Makefile
scripts
README.md
LICENSE
